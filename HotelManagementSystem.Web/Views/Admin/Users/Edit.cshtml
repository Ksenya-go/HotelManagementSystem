@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@model HotelManagementSystem.Web.ViewModels.Admin.EditEmployeeViewModel

@{
    ViewData["Title"] = L["EditEmployee"];
}

<div class="page-heading">
    <div>
        <div class="eyebrow"> @L["Users"]</div>
        <h1>@L["EditEmployee"]</h1>
        <p class="page-subtitle">@L["EditEmployeeDescription"]</p>
    </div>
</div>

<section class="content-card form-card">

    <form method="post"
          asp-controller="AdminUsers"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          class="form-narrow">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-field">
            <label asp-for="FullName" class="form-label">
                @L["FullName"]
            </label>

            <input asp-for="FullName" class="form-control" required />

            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Email" class="form-label">
                @L["Email"]
            </label>
            <input asp-for="Email" class="form-control" autocomplete="username" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Role" class="form-label">
                @L["Role"]
            </label>

            <select asp-for="Role" class="form-select" required>
                @foreach (var role in Model.AvailableRoles)
                {
                    <option value="@role">
                        @(role == "Employee" ? L["Employee"] : role == "Admin" ? L["Admin"] : role)
                    </option>
                }

            </select>

            <span asp-validation-for="Role" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="NewPassword" class="form-label">
                @L["NewPassword"]
            </label>
            <input asp-for="NewPassword"
                   class="form-control"
                   autocomplete="new-password"
                   aria-describedby="new-password-help" />
            <div id="new-password-help" class="form-text">
                @L["NewPasswordHelp"]
            </div>
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-teal">@L["SaveChanges"]</button>

            <a asp-controller="AdminUsers"
               asp-action="Index"
               class="btn btn-cancel">
                @L["Cancel"]
            </a>

        </div>

    </form>

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
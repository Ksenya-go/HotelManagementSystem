@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@model HotelManagementSystem.Web.ViewModels.Reservation.ReservationFormViewModel

@{
    ViewData["Title"] = L["NewReservation"];
}

<div class="page-heading">
    <div>
        <h1>@L["NewReservation"]</h1>
    </div>
</div>

<section class="content-card form-card">
    <form method="post"
          asp-action="Create"
          class="form-narrow">

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <input type="hidden" asp-for="RoomId" />
        <input type="hidden" asp-for="RoomNumber" />
        <input type="hidden" asp-for="RoomFloor" />
        <input type="hidden" asp-for="RoomType" />
        <input type="hidden" asp-for="RoomPricePerDay" />
        <input type="hidden" asp-for="RoomCapacity" />
        <input type="hidden" asp-for="CheckIn" />
        <input type="hidden" asp-for="CheckInTime" />
        <input type="hidden" asp-for="CheckOut" />
        <input type="hidden" asp-for="CheckOutTime" />
        <input type="hidden" asp-for="GuestsCount" />

        <div class="form-field">
            <label class="form-label">@L["SelectedRoom"]</label>
            <input class="form-control form-control-readonly"
                   value="@Model.RoomNumber"
                   readonly
                   tabindex="-1" />
        </div>

        <div class="form-field">
            <label class="form-label">@L["Floor"]</label>
            <input class="form-control form-control-readonly"
                   value="@Model.RoomFloor"
                   readonly
                   tabindex="-1" />
        </div>

        <div class="form-field">
            <label class="form-label">@L["RoomType"]</label>
            <input class="form-control form-control-readonly"
                   value="@Model.RoomType"
                   readonly
                   tabindex="-1" />
        </div>

        <div class="form-field">
            <label class="form-label">@L["PricePerNight"]</label>
            <input class="form-control form-control-readonly"
                   value="@Model.RoomPricePerDay.ToString("N2")"
                   readonly
                   tabindex="-1" />
        </div>

        <div class="form-field">
            <label class="form-label">@L["RoomCapacity"]</label>
            <input class="form-control form-control-readonly"
                   value="@Model.RoomCapacity"
                   readonly
                   tabindex="-1" />
        </div>

        <div class="form-field">
            <label class="form-label">@L["CheckIn"]</label>
            <input class="form-control form-control-readonly"
                   value="@Model.CheckIn @Model.CheckInTime"
                   readonly
                   tabindex="-1" />
        </div>

        <div class="form-field">
            <label class="form-label">@L["CheckOut"]</label>
            <input class="form-control form-control-readonly"
                   value="@Model.CheckOut @Model.CheckOutTime"
                   readonly
                   tabindex="-1" />
        </div>

        <div class="form-field">
            <label asp-for="NewGuestFirstName" class="form-label">
                @L["FirstName"]
            </label>
            <input asp-for="NewGuestFirstName"
                   class="form-control"
                   required />
        </div>

        <div class="form-field">
            <label asp-for="NewGuestLastName" class="form-label">
                @L["LastName"]
            </label>
            <input asp-for="NewGuestLastName"
                   class="form-control"
                   required />
        </div>

        <div class="form-field">
            <label asp-for="NewGuestEmail" class="form-label">
                @L["Email"]
            </label>
            <input asp-for="NewGuestEmail"
                   class="form-control"
                   required />
        </div>

        <div class="form-field">
            <label asp-for="NewGuestPhone" class="form-label">
                @L["Phone"]
            </label>
            <input asp-for="NewGuestPhone"
                   class="form-control"
                   required />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-teal">
                @L["CreateReservation"]
            </button>

            <a asp-controller="Rooms"
               asp-action="Booking"
               asp-route-startDate="@Model.CheckIn"
               asp-route-endDate="@Model.CheckOut"
               asp-route-guestsCount="@Model.GuestsCount"
               class="btn btn-cancel">
                @L["Cancel"]
            </a>
        </div>

    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@model HotelManagementSystem.Web.ViewModels.Rooms.RoomCreateViewModel


@{
    ViewData["Title"] = L["AddRoom"];
}

<div class="page-heading">
    <div>
        <h1>@L["AddRoom"]</h1>
    </div>
</div>

<section class="content-card form-card">
    <form method="post" asp-action="Create" class="form-narrow">

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-field">
            <label asp-for="RoomNumber" class="form-label"></label>
            <input asp-for="RoomNumber" class="form-control" required />
            <span asp-validation-for="RoomNumber" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Type" class="form-label">@L["RoomType"]</label>
            <input asp-for="Type" class="form-control" required />
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Description" class="form-label">@L["Description"]</label>
            <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="PricePerDay" class="form-label">@L["PricePerNight"]</label>
            <input asp-for="PricePerDay" type="number" step="0.01" class="form-control" required />
            <span asp-validation-for="PricePerDay" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Capacity" class="form-label"></label>
            <input asp-for="Capacity" type="number" min="1" max="20" class="form-control" required />
            <span asp-validation-for="Capacity" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="RoomCount" class="form-label"></label>
            <input asp-for="RoomCount" type="number" min="1" max="20" class="form-control" required />
            <span asp-validation-for="RoomCount" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="Floor" class="form-label">@L["Floor"]</label>
            <select asp-for="Floor" class="form-select" required>
                <option value="">@L["SelectFloor"]</option>

                @for (var floor = 1; floor <= 9; floor++)
                {
                    <option value="@floor">@floor</option>
                }
            </select>

            <span asp-validation-for="Floor" class="text-danger"></span>
        </div>

        <div class="form-field">
            <label asp-for="OperationalStatus" class="form-label">@L["RoomStatus"]</label>

            <select asp-for="OperationalStatus" class="form-select" required>
                <option value="Clean">@L["RoomStatus_Clean"]</option>
                <option value="Cleaning">@L["RoomStatus_Cleaning"]</option>
                <option value="InMaintenance">@L["RoomStatus_InMaintenance"]</option>
            </select>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-teal">
                @L["AddRoom"]
            </button>

            <a asp-action="Index" class="btn btn-cancel">
                @L["Cancel"]
            </a>
        </div>

    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
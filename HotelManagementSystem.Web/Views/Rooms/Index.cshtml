@model HotelManagementSystem.Web.ViewModels.Rooms.RoomListViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@using HotelManagementSystem.Domain.Room
@{
    ViewData["Title"] = L["Rooms"];

    string GetRoomStatusText(RoomOperationalStatus status)
    {
        return L[$"RoomStatus_{status}"].Value;
    }
}
<div class="page-heading rooms-page-heading">
    <div class="rooms-heading-content">
        <h1>@L["Rooms"]</h1>
        <p class="page-subtitle">
            @L["RoomListDescription"]
        </p>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert app-alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert app-alert alert-danger">@error</div>
}

<section class="content-card form-card mb-4 rooms-filter-card">
    <form method="get" asp-action="Index">
        <div class="room-filter-row">
            <div class="form-field form-field-inline">
                <label asp-for="Floor" class="form-label">@L["Floor"]</label>
                <input asp-for="Floor" type="text" class="form-control" />
            </div>
            <div class="form-field form-field-inline">
                <label asp-for="RoomType" class="form-label">@L["RoomType"]</label>
                <input asp-for="RoomType" type="text" class="form-control" />
            </div>
            <div class="form-field form-field-inline">
                <label asp-for="MinPrice" class="form-label">@L["MinPrice"]</label>
                <input asp-for="MinPrice" type="number" step="0.01" class="form-control" />
            </div>
            <div class="form-field form-field-inline">
                <label asp-for="MaxPrice" class="form-label">@L["MaxPrice"]</label>
                <input asp-for="MaxPrice" type="number" step="0.01" class="form-control" />
            </div>

            <div class="room-filter-buttons">
                <button type="submit" class="btn btn-teal">@L["Filter"]</button>
                <a asp-action="Index" class="btn btn-cancel">@L["Clear"]</a>
            </div>

            <a asp-action="Create" class="btn btn-teal rooms-add-btn">
                @L["AddRoom"]
            </a>
        </div>
        <input type="hidden" name="pageNumber" value="1" />
    </form>
</section>

<section class="content-card table-card mb-4">
    <div class="card-heading">
        <div>
            <h2>@L["RoomList"]</h2>
            <p>@L["RoomCount", Model.TotalCount]</p>
        </div>
    </div>
    <div class="table-responsive">
        <table class="hotel-table">
            <thead class="text-center">
                <tr>
                    <th>@L["Room"]</th>
                    <th>@L["Floor"]</th>
                    <th>@L["Type"]</th>
                    <th>@L["Description"]</th>
                    <th>@L["PricePerNight"]</th>
                    <th>@L["Capacity"]</th>
                    <th>@L["RoomQuantity"]</th>
                    <th>@L["RoomStatus"]</th>
                    <th>@L["Actions"]</th>
                </tr>
            </thead>
            <tbody class="text-center">
                @foreach (var room in Model.Rooms)
                {
                    <tr>
                        <td><strong>@room.RoomNumber</strong></td>
                        <td>@room.Floor</td>
                        <td>@room.Type</td>
                        <td>@(string.IsNullOrWhiteSpace(room.Description) ? L["EmptyValue"] : room.Description)</td>
                        <td>@room.PricePerDay.ToString("N2")</td>
                        <td>@room.Capacity</td>
                        <td>@room.RoomCount</td>
                        <td>@GetRoomStatusText(room.OperationalStatus)</td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@room.Id" class="btn btn-teal">@L["Edit"]</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <button type="button"
                                            class="btn btn-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#delete-room-@room.Id">
                                        @L["Delete"]
                                    </button>
                                }
                            </div>

                            @if (User.IsInRole("Admin"))
                            {
                                <div class="modal fade"
                                     id="delete-room-@room.Id"
                                     tabindex="-1"
                                     aria-labelledby="delete-room-title-@room.Id"
                                     aria-hidden="true">

                                    <div class="modal-dialog modal-dialog-centered reservation-delete-modal">

                                        <div class="modal-content">

                                            <div class="modal-header">
                                                <div>

                                                    <h2 class="modal-title"
                                                        id="delete-room-title-@room.Id">
                                                        @L["DeleteRoomConfirm"]
                                                    </h2>
                                                </div>

                                                <button type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="modal"
                                                        aria-label="@L["Close"]">
                                                </button>
                                            </div>

                                            <div class="modal-body">
                                                <div class="delete-reservation-info">

                                                    <div class="delete-info-item">
                                                        <span>@L["Room"]</span>
                                                        <strong>
                                                            @room.RoomNumber
                                                        </strong>
                                                    </div>

                                                    <div class="delete-info-item">
                                                        <span>@L["RoomType"]</span>
                                                        <strong>
                                                            @room.Type
                                                        </strong>
                                                    </div>

                                                    <div class="delete-info-item">
                                                        <span>@L["PricePerNight"]</span>
                                                        <strong>
                                                            @room.PricePerDay.ToString("N2")
                                                        </strong>
                                                    </div>

                                                    <div class="delete-info-item">
                                                        <span>@L["Capacity"]</span>
                                                        <strong>
                                                            @room.Capacity
                                                        </strong>
                                                    </div>

                                                </div>

                                                <div class="delete-warning">
                                                    <span class="delete-warning-icon">!</span>

                                                    <span>
                                                        @L["DeleteRoomWarning"]
                                                    </span>
                                                </div>

                                            </div>

                                            <div class="modal-footer">

                                                <button type="button"
                                                        class="btn btn-cancel"
                                                        data-bs-dismiss="modal">
                                                    @L["Cancel"]
                                                </button>

                                                <form method="post"
                                                      asp-action="Delete"
                                                      asp-route-id="@room.Id">

                                                    <button type="submit"
                                                            class="btn btn-danger">
                                                        @L["DeleteRoom"]
                                                    </button>

                                                </form>

                                            </div>

                                        </div>

                                    </div>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav class="pagination-nav" aria-label="@L["RoomPagination"]">
            <a class="btn btn-sm btn-outline-teal @(Model.PageNumber <= 1 ? "disabled" : "")"
               asp-action="Index"
               asp-route-floor="@Model.Floor"
               asp-route-roomType="@Model.RoomType"
               asp-route-minPrice="@Model.MinPrice"
               asp-route-maxPrice="@Model.MaxPrice"
               asp-route-pageNumber="@(Model.PageNumber - 1)">@L["Previous"]</a>
            @for (var currentPage = 1; currentPage <= Model.TotalPages; currentPage++)
            {
                <a class="btn btn-sm @(currentPage == Model.PageNumber ? "btn-teal" : "btn-outline-teal")"
                   asp-action="Index"
                   asp-route-floor="@Model.Floor"
                   asp-route-roomType="@Model.RoomType"
                   asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice"
                   asp-route-pageNumber="@currentPage">@currentPage</a>
            }
            <a class="btn btn-sm btn-outline-teal @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")"
               asp-action="Index"
               asp-route-floor="@Model.Floor"
               asp-route-roomType="@Model.RoomType"
               asp-route-minPrice="@Model.MinPrice"
               asp-route-maxPrice="@Model.MaxPrice"
               asp-route-pageNumber="@(Model.PageNumber + 1)">@L["Next"]</a>
        </nav>
    }
</section>